class Ward < Formula
  desc "Menu-bar utility for things macOS makes hard"
  homepage "https://github.com/shelupets89/ward"
  url "__URL__"
  sha256 "__SHA256__"
  license "MIT"

  # Deliberately no `head` spec. Everything else here exists to pin one
  # checksummed tarball, and `--HEAD` would offer an unpinned path around that.
  livecheck do
    url :stable
    strategy :github_latest
  end

  depends_on macos: :ventura

  # Compiling on the installing machine is the whole point, not an
  # implementation detail. A downloaded .app carries com.apple.quarantine, and
  # Ward has no Developer ID to satisfy the Gatekeeper check that follows — the
  # dialog it produces offers no Open button. Nothing built here was
  # downloaded, so nothing is quarantined and the app simply opens.
  def install
    # SwiftPM evaluates Package.swift inside its own sandbox-exec sandbox, and
    # the kernel refuses to nest that inside Homebrew's. Without this the build
    # fails as an unexplained "Invalid manifest".
    ENV["WARD_DISABLE_SWIFTPM_SANDBOX"] = "1"
    system "bash", "scripts/make-app.sh"
    prefix.install "dist/Ward.app"

    # The .app cannot go in /Applications from here, and `bin` is the one
    # directory Homebrew links onto PATH — so this shim is the whole of what an
    # install is able to do to shorten the step it is not allowed to take.
    bin.install "packaging/homebrew/ward"

    # opt_prefix rather than prefix: the opt path does not move between
    # versions, which is what lets the symlink the shim writes survive
    # `brew upgrade` untouched. inreplace fails the build if the placeholder is
    # gone, so a renamed token cannot ship a shim that links a literal
    # __WARD_APP__ — and the test below covers the other direction.
    inreplace bin/"ward", "__WARD_APP__", "#{opt_prefix}/Ward.app"
  end

  def caveats
    <<~EOS
      Ward.app was compiled on this machine, so it carries no quarantine flag
      and opens with no Gatekeeper dialog. One step left:

        ward

      That links Ward into /Applications and opens it. It is a command rather
      than part of the install because Homebrew's sandbox is not permitted to
      write there. Running it again is harmless — it re-opens Ward and reports
      the link is already in place, and it refuses to touch an app it did not
      put there.

      `brew upgrade ward` needs no relink: the link names a path that does not
      move between versions. `brew uninstall ward` leaves it dangling, and
      nothing else will clean it up:

        rm /Applications/Ward.app

      Ward is ad-hoc signed, and macOS ties an Accessibility grant to the exact
      binary it was given. Every upgrade rebuilds Ward into a new one, so
      Cleaning Mode needs Accessibility granted again afterwards, under
      System Settings -> Privacy & Security -> Accessibility.

      Remove the old Ward entry with "-" and add it back. Do not just flip its
      switch: the stale entry goes on showing itself as enabled while granting
      nothing, because it still names the previous build.
    EOS
  end

  test do
    app = prefix/"Ward.app"
    assert_path_exists app/"Contents/MacOS/Ward"

    # codesign seals whatever is in the bundle, so one built without the notice
    # verifies perfectly — presence is the half the check below cannot catch.
    assert_path_exists app/"Contents/Resources/LICENSE"

    # The bundle must stay signed: an unsigned binary is one macOS refuses to
    # keep an Accessibility grant for at all.
    system "codesign", "--verify", "--strict", app

    bundle_version = shell_output(
      "/usr/libexec/PlistBuddy -c 'Print CFBundleShortVersionString' #{app}/Contents/Info.plist",
    ).strip
    assert_equal version.to_s, bundle_version

    # Two things already stand between a user and an unsubstituted shim:
    # `inreplace` fails the build when the placeholder is not found, and the
    # shim refuses to run while it still holds one — it dies at its own `-d`
    # guard, exit 1, having linked nothing. Neither covers the file being
    # rewritten or replaced *after* that step, which is the only route by which
    # a placeholder could actually reach someone. That is what this catches.
    refute_match "__WARD_APP__", (bin/"ward").read

    # /Applications is off-limits in here for the same reason it is off-limits
    # during install, so the link is proved against a scratch directory. The
    # launcher is stubbed with `true`: `brew test` must not leave a menu-bar app
    # running on the machine.
    #
    # scripts/ward-shim-tests.sh covers the branches this cannot reach — every
    # refusal needs something already sitting in /Applications.
    applications = testpath/"Applications"
    applications.mkpath
    linked = applications/"Ward.app"

    with_env("WARD_APPLICATIONS_DIR" => applications.to_s, "WARD_OPEN_COMMAND" => "true") do
      system bin/"ward"
      assert_predicate linked, :symlink?
      assert_equal "#{opt_prefix}/Ward.app", linked.readlink.to_s

      # Idempotent, because caveats say running it again is harmless.
      system bin/"ward"
      assert_predicate linked, :symlink?
      assert_equal "#{opt_prefix}/Ward.app", linked.readlink.to_s
    end
  end
end
